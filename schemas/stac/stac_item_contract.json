{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeoClimateSTACItemContract",
  "type": "object",
  "required": ["type", "stac_version", "id", "geometry", "bbox", "properties", "assets", "links"],
  "properties": {
    "type": {"const": "Feature"},
    "stac_version": {"enum": ["1.0.0", "1.1.0"]},
    "id": {"type": "string", "minLength": 3},
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number"}
    },
    "properties": {
      "type": "object",
      "required": ["datetime", "proj:epsg", "eo:cloud_cover", "license", "geoclimate:region_id", "geoclimate:sha256"],
      "properties": {
        "datetime": {"type": "string"},
        "proj:epsg": {"type": "integer"},
        "eo:cloud_cover": {"type": "number", "minimum": 0.0, "maximum": 100.0},
        "license": {"type": "string"},
        "geoclimate:region_id": {"type": "string"},
        "geoclimate:sha256": {"type": "string", "minLength": 64, "maxLength": 64},
        "geoclimate:scene_version": {"type": "integer", "minimum": 1}
      }
    },
    "assets": {
      "type": "object",
      "required": ["multispectral_cog"]
    }
  }
}

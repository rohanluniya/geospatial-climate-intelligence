# Geospatial & Climate Intelligence Engine — Environment Template
# Copy to .env for local overrides. NEVER commit real production tokens.

GEO_CLIMATE_DATA_DIR=.local_data
GEO_CLIMATE_SEED=20260801
GEO_CLIMATE_API_HOST=127.0.0.1
GEO_CLIMATE_API_PORT=8070

# Local dev API tokens (replace via secret manager in production)
GEO_CLIMATE_VIEWER_TOKEN=dev-viewer-token-geo08
GEO_CLIMATE_ANALYST_TOKEN=dev-analyst-token-geo08
GEO_CLIMATE_ADMIN_TOKEN=dev-admin-token-geo08

# Optional distributed stack settings (docker-compose.yml)
OTEL_ARCH=arm64
RUSTFS_ACCESS_KEY=dev-rustfs-access
RUSTFS_SECRET_KEY=dev-rustfs-secret-change-me
POSTGIS_USER=geoclimate
POSTGIS_PASSWORD=dev-postgis-change-me
POSTGIS_DB=geoclimate
